<UserControl x:Class="ControllerDesktop.App.MappingVisualPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left palette -->
        <Border Grid.Column="0" Background="#F7F7FA" CornerRadius="8" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="PaletteHeader" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="PalettePanel" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Controller diagram -->
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="16,0,0,0">
            <Canvas x:Name="Diagram" Width="860" Height="560" Background="#FCFCFE" />
        </ScrollViewer>
    </Grid>
</UserControl>
