<UserControl x:Class="ControllerDesktop.App.MappingVisualPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#FAFBFC">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：按键选择列表 -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <TextBlock DockPanel.Dock="Top" x:Name="ButtonListHeader"
                          Text="按键列表" FontSize="16" FontWeight="SemiBold"
                          Foreground="#111827" Margin="0,0,0,16" />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ButtonListPanel" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 中间：手柄图示 + 标注 -->
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto" Padding="32">
            <Canvas x:Name="DiagramCanvas" Width="900" Height="680" Background="Transparent" />
        </ScrollViewer>

        <!-- 右侧：选中按键的配置面板 -->
        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1,0,0,0">
            <DockPanel Margin="20">
                <TextBlock DockPanel.Dock="Top" x:Name="ConfigPanelHeader"
                          Text="按键配置" FontSize="16" FontWeight="SemiBold"
                          Foreground="#111827" Margin="0,0,0,4" />
                <TextBlock DockPanel.Dock="Top" x:Name="SelectedButtonHint"
                          Text="从左侧选择一个按键开始配置"
                          FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,24" />

                <StackPanel x:Name="ConfigPanel" Visibility="Collapsed">
                    <!-- 当前选中的按键 -->
                    <Border Background="#F0F9FF" BorderBrush="#3B82F6" BorderThickness="1"
                           CornerRadius="8" Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="当前按键" FontSize="11" Foreground="#1E40AF"
                                      FontWeight="Medium" Margin="0,0,0,4"/>
                            <TextBlock x:Name="CurrentButtonName" Text="A"
                                      FontSize="20" FontWeight="Bold" Foreground="#1E3A8A"/>
                        </StackPanel>
                    </Border>

                    <!-- 映射类型选择 -->
                    <TextBlock Text="映射类型" FontSize="13" FontWeight="Medium"
                              Foreground="#374151" Margin="0,0,0,8"/>
                    <ComboBox x:Name="ActionTypeCombo" Height="36" FontSize="13"
                             SelectionChanged="ActionType_Changed" Margin="0,0,0,20">
                        <ComboBoxItem Content="键盘按键" Tag="Key"/>
                        <ComboBoxItem Content="组合键" Tag="Combo"/>
                        <ComboBoxItem Content="鼠标左键" Tag="MouseLeft"/>
                        <ComboBoxItem Content="鼠标右键" Tag="MouseRight"/>
                        <ComboBoxItem Content="鼠标中键" Tag="MouseMiddle"/>
                        <ComboBoxItem Content="鼠标侧键1" Tag="MouseX1"/>
                        <ComboBoxItem Content="鼠标侧键2" Tag="MouseX2"/>
                        <ComboBoxItem Content="鼠标滚轮上" Tag="MouseWheelUp"/>
                        <ComboBoxItem Content="鼠标滚轮下" Tag="MouseWheelDown"/>
                        <ComboBoxItem Content="无操作" Tag="None"/>
                    </ComboBox>

                    <!-- 键盘按键输入（仅在选择键盘按键时显示） -->
                    <StackPanel x:Name="KeyInputPanel" Visibility="Collapsed">
                        <TextBlock Text="键盘按键" FontSize="13" FontWeight="Medium"
                                  Foreground="#374151" Margin="0,0,0,8"/>
                        <Button x:Name="CaptureKeyButton" Height="48"
                               Background="#F9FAFB" BorderBrush="#D1D5DB"
                               BorderThickness="1" Click="CaptureKey_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎯" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock x:Name="CapturedKeyDisplay" Text="点击捕获按键"
                                          FontSize="13" Foreground="#6B7280"/>
                            </StackPanel>
                        </Button>

                        <!-- 快捷按键选择 -->
                        <TextBlock Text="或选择常用按键" FontSize="12" Foreground="#9CA3AF"
                                  Margin="0,16,0,8"/>
                        <WrapPanel x:Name="QuickKeyPanel" />
                    </StackPanel>

                    <!-- 组合键输入（仅在选择组合键时显示） -->
                    <StackPanel x:Name="ComboKeyInputPanel" Visibility="Collapsed">
                        <TextBlock Text="组合键设置" FontSize="13" FontWeight="Medium"
                                  Foreground="#374151" Margin="0,0,0,8"/>

                        <!-- 修饰键（Ctrl、Shift、Alt） -->
                        <TextBlock Text="修饰键" FontSize="12" Foreground="#6B7280" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,12">
                            <CheckBox x:Name="CtrlCheckBox" Content="Ctrl" Margin="0,0,12,0" Checked="ModifierKey_Changed" Unchecked="ModifierKey_Changed"/>
                            <CheckBox x:Name="ShiftCheckBox" Content="Shift" Margin="0,0,12,0" Checked="ModifierKey_Changed" Unchecked="ModifierKey_Changed"/>
                            <CheckBox x:Name="AltCheckBox" Content="Alt" Margin="0,0,12,0" Checked="ModifierKey_Changed" Unchecked="ModifierKey_Changed"/>
                            <CheckBox x:Name="WinCheckBox" Content="Win" Margin="0,0,0,0" Checked="ModifierKey_Changed" Unchecked="ModifierKey_Changed"/>
                        </WrapPanel>

                        <!-- 主按键 -->
                        <TextBlock Text="主按键" FontSize="12" Foreground="#6B7280" Margin="0,0,0,6"/>
                        <Button x:Name="CaptureComboKeyButton" Height="48"
                               Background="#F9FAFB" BorderBrush="#D1D5DB"
                               BorderThickness="1" Click="CaptureComboKey_Click" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎯" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock x:Name="CapturedComboKeyDisplay" Text="点击捕获主按键"
                                          FontSize="13" Foreground="#6B7280"/>
                            </StackPanel>
                        </Button>

                        <!-- 组合键预览 -->
                        <Border Background="#F0F9FF" BorderBrush="#BFDBFE" BorderThickness="1"
                               CornerRadius="6" Padding="12" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="组合键预览" FontSize="11" Foreground="#1E40AF" Margin="0,0,0,4"/>
                                <TextBlock x:Name="ComboKeyPreview" Text="未设置"
                                          FontSize="14" FontWeight="SemiBold" Foreground="#1E3A8A"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 保存按钮 -->
                    <Button x:Name="SaveMappingButton" Height="40" Margin="0,32,0,0"
                           Background="#3B82F6" Foreground="White" FontWeight="Medium"
                           BorderThickness="0" Click="SaveMapping_Click">
                        <TextBlock Text="保存配置" FontSize="13"/>
                    </Button>

                    <!-- 清除映射 -->
                    <Button x:Name="ClearMappingButton" Height="36" Margin="0,8,0,0"
                           Background="Transparent" Foreground="#EF4444"
                           BorderBrush="#FEE2E2" BorderThickness="1" Click="ClearMapping_Click">
                        <TextBlock Text="清除此按键映射" FontSize="12"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
