<UserControl x:Class="ControllerDesktop.App.GamepadTestPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock x:Name="ConnectionText" FontSize="16" FontWeight="SemiBold" />
        <TextBlock x:Name="ButtonsText" Margin="0,12,0,0" FontSize="14" FontFamily="Consolas" />
        <TextBlock x:Name="SticksText" Margin="0,8,0,0" FontSize="14" FontFamily="Consolas" />
        <TextBlock x:Name="HintText" Margin="0,20,0,0" FontSize="12" Foreground="#777" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
