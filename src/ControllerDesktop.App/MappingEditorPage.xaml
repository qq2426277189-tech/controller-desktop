<UserControl x:Class="ControllerDesktop.App.MappingEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="BindingsHeader" FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="BindingsHint" Margin="0,4,0,0" FontSize="12" Foreground="#777" />
        </StackPanel>

        <DataGrid x:Name="BindingsGrid" Grid.Row="1" AutoGenerateColumns="False"
                  CanUserAddRows="True" CanUserDeleteRows="True" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ButtonColumn" Header="Button" Binding="{Binding Button}" Width="140" />
                <DataGridComboBoxColumn x:Name="ActionColumn" Header="Action" SelectedItemBinding="{Binding Action}" Width="160" />
                <DataGridTextColumn x:Name="ValueColumn" Header="Target" Binding="{Binding Value}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StickHeader" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
            <UniformGrid Columns="4">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock x:Name="MouseSpeedLabel" FontSize="12" Foreground="#555" />
                    <TextBox x:Name="MouseSpeedBox" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock x:Name="DeadzoneLabel" FontSize="12" Foreground="#555" />
                    <TextBox x:Name="DeadzoneBox" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock x:Name="SensitivityLabel" FontSize="12" Foreground="#555" />
                    <TextBox x:Name="SensitivityBox" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="InvertYLabel" FontSize="12" Foreground="#555" />
                    <CheckBox x:Name="InvertYBox" VerticalAlignment="Center" />
                </StackPanel>
            </UniformGrid>
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button x:Name="SaveButton" Width="120" Height="32" Click="Save_Click" />
                <Button x:Name="ResetButton" Width="120" Height="32" Margin="10,0,0,0" Click="Reset_Click" />
            </StackPanel>
            <TextBlock x:Name="SaveStatus" Margin="0,10,0,0" FontSize="13" Foreground="#2a7" />
        </StackPanel>
    </Grid>
</UserControl>

