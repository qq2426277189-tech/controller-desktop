<Window x:Class="ControllerDesktop.App.QuickMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="#F0262933" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" Topmost="True"
        ShowActivated="False" Focusable="False">
    <Border Background="#F0262933" CornerRadius="10" Padding="12" BorderBrush="#66FFFFFF" BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="HeaderText" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="4,2,0,8" />
            <ItemsControl x:Name="List" Focusable="False" />
        </StackPanel>
    </Border>
</Window>
