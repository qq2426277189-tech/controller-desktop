<Window x:Class="ControllerDesktop.App.KeyCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="ToolWindow" WindowStartupLocation="CenterScreen"
        Width="360" SizeToContent="Height" Topmost="True" ResizeMode="NoResize"
        Background="#1E1F24" Foreground="White">
    <StackPanel Margin="20">
        <TextBlock Text="捕获组合键的主按键" FontSize="15" FontWeight="SemiBold" />
        <TextBlock Text="按一个键盘键，不要按 Ctrl / Shift / Alt / Win。Esc 取消。" FontSize="12" Foreground="#AAA" Margin="0,6,0,0" TextWrapping="Wrap" />
        <Border Background="#2A2B31" CornerRadius="6" Padding="14,10" Margin="0,14,0,0">
            <TextBlock x:Name="ResultText" FontSize="16" Foreground="#6FCF97" />
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="确定" Width="90" Height="30" Click="Ok_Click" />
            <Button Content="取消" Width="80" Height="30" Margin="8,0,0,0" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
