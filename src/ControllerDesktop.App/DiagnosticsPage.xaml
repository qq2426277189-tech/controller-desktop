<UserControl x:Class="ControllerDesktop.App.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button x:Name="RefreshButton" Content="刷新" Width="80" Height="30" Click="Refresh_Click" />
            <Button x:Name="OpenLogsButton" Content="打开日志目录" Width="110" Height="30" Margin="8,0,0,0" Click="OpenLogs_Click" />
            <Button x:Name="OpenConfigButton" Content="打开配置目录" Width="110" Height="30" Margin="8,0,0,0" Click="OpenConfig_Click" />
            <TextBlock x:Name="UpdatedText" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#777" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="RuntimeHeader" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="RuntimeText" Margin="0,6,0,0" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" />

                <TextBlock x:Name="GamepadHeader" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,0" />
                <TextBlock x:Name="GamepadText" Margin="0,6,0,0" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" />

                <TextBlock x:Name="ForegroundHeader" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,0" />
                <TextBlock x:Name="ForegroundText" Margin="0,6,0,0" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" />

                <TextBlock x:Name="PathsHeader" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,0" />
                <TextBlock x:Name="PathsText" Margin="0,6,0,0" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" />

                <TextBlock x:Name="LogHeader" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,0" />
                <Border Background="#111827" CornerRadius="6" Padding="10" Margin="0,6,0,0">
                    <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="11" Foreground="#D1D5DB"
                               TextWrapping="Wrap" MaxHeight="220" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
