<Window x:Class="ControllerDesktop.App.CaptureKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="ToolWindow" WindowStartupLocation="CenterScreen"
        Width="380" SizeToContent="Height" Topmost="True" ResizeMode="NoResize"
        Background="#1E1F24" Foreground="White">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="SubText" FontSize="12" Foreground="#AAA" Margin="0,6,0,0" TextWrapping="Wrap" />
        <Border Background="#2A2B31" CornerRadius="6" Padding="14,10" Margin="0,14,0,0">
            <TextBlock x:Name="ResultText" FontSize="16" Foreground="#6FCF97" />
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="确定" Width="90" Height="30" Click="Ok_Click" />
            <Button x:Name="ClearButton" Content="清空(无动作)" Width="110" Height="30" Margin="8,0,0,0" Click="Clear_Click" />
            <Button x:Name="CancelButton" Content="取消" Width="80" Height="30" Margin="8,0,0,0" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
