<Window x:Class="ControllerDesktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ControllerDesktop" Height="420" Width="720">
    <Grid Margin="24">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="28" FontWeight="Bold" Text="ControllerDesktop" />
            <TextBlock x:Name="SubtitleText" Margin="0,8,0,24" FontSize="14" Text="手柄桌面控制 v2 / Gamepad desktop control v2" />
            <StackPanel Orientation="Horizontal">
                <Button Content="中文" Width="120" Height="36" Margin="0,0,12,0" Click="Chinese_Click" />
                <Button Content="English" Width="120" Height="36" Click="English_Click" />
            </StackPanel>
            <TextBlock Margin="0,28,0,0" TextWrapping="Wrap" FontSize="13" Text="当前为项目骨架：改键、配置系统、安装包和自动更新将在后续版本加入。" />
        </StackPanel>
    </Grid>
</Window>
