<Window x:Class="ControllerDesktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ControllerDesktop" Height="640" Width="980" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock x:Name="TitleText" FontSize="26" FontWeight="Bold" Text="ControllerDesktop" />
                <TextBlock x:Name="SubtitleText" Margin="0,4,0,0" Foreground="#666" Text="手柄桌面控制 v2" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="ChineseButton" Content="中文" Width="80" Height="32" Margin="0,0,8,0" Click="Chinese_Click" />
                <Button x:Name="EnglishButton" Content="English" Width="90" Height="32" Click="English_Click" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="NavList" Grid.Column="0" SelectionChanged="NavList_SelectionChanged" FontSize="15" />

            <Border Grid.Column="1" Margin="18,0,0,0" Background="#F5F6F8" CornerRadius="8" Padding="24">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" FontSize="24" FontWeight="Bold" />
                    <TextBlock x:Name="PageDescription" Margin="0,12,0,0" FontSize="14" TextWrapping="Wrap" Foreground="#555" />
                    <TextBlock x:Name="StatusText" Margin="0,28,0,0" FontSize="13" Foreground="#777" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="VersionText" Grid.Row="2" Margin="0,14,0,0" Foreground="#888" />
    </Grid>
</Window>
